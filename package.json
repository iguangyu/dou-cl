{
  "name": "dou-cl",
  "version": "1.1.0",
  "description": "伪装成开发控制台的命令行牌桌 —— 斗地主 / 跑得快 / 510K，牌局藏在日志流、xxd、JSON 或 git diff 里；支持局域网联机，也有公共房间可直接和真人开局",
  "keywords": [
    "doudizhu",
    "斗地主",
    "跑得快",
    "510k",
    "cli",
    "game",
    "card-game",
    "terminal",
    "tui",
    "stealth",
    "multiplayer",
    "lan"
  ],
  "license": "MIT",
  "author": "iguangyu",
  "homepage": "https://github.com/iguangyu/dou-cl#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iguangyu/dou-cl.git"
  },
  "bugs": {
    "url": "https://github.com/iguangyu/dou-cl/issues"
  },
  "engines": {
    "node": ">=16"
  },
  "bin": {
    "dou-cl": "bin/dou-cl.js",
    "doucl": "bin/dou-cl.js"
  },
  "main": "src/app.js",
  "files": [
    "bin",
    "src",
    "README.md",
    "PUBLISH.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/dou-cl.js",
    "serve": "node bin/dou-cl.js --serve",
    "plain": "node bin/dou-cl.js --skin term",
    "hex": "node bin/dou-cl.js --skin hex",
    "test": "node test/sim.js && node test/smoke.js && node test/local-test.js && node test/skins-test.js && node test/exercise-test.js",
    "sim": "node test/sim.js",
    "smoke": "node test/smoke.js",
    "local": "node test/local-test.js",
    "skins": "node test/skins-test.js",
    "drill": "node test/exercise-test.js",
    "preview": "node test/make-preview.js",
    "docs": "node tools/make-docs.js",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
